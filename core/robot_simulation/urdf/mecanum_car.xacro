<?xml version="1.0"?>
<!--
  ============================================================================
  mecanum_car.xacro —— 基于亚博 yahboomcar.urdf 结构改造的参数化麦轮小车模型
  ============================================================================
  用途：真机模型描述（TF / RViz / 导航）。外观用基本几何体，不需要 STL。
  link/joint 命名与亚博一致，程序里引用的 TF 帧名（base_link、left_front_wheel、
  lidar_link、camera_link、imu_link 等）不用改动，只改下面的参数即可。

  ─────────────────── 量尺寸清单（卷尺 + 卡尺，在真机上量）───────────────────
  ① wheel_radius   轮半径 = 轮子直径 ÷ 2
  ② wheel_width    轮子厚度（沿车宽方向）
  ③ wheelbase      轴距   = 前轮轴到后轮轴中心的距离
  ④ track_width    轮距   = 左轮中心到右轮中心的距离
  ⑤ base_length / base_width / base_height   车体长 / 宽 / 高（碰撞和避障用）
  ⑥ lidar_x / lidar_y / lidar_z              雷达相对车体中心的前后/左右偏移、离地高度
  ⑦ camera_x / camera_z                      相机前后偏移、离地高度
  ⑧ imu_x / imu_y / imu_z                    IMU 位置（真机上没有就保持 0）
  ────────────────────────────────────────────────────────────────────────────
  坐标系约定：
    base_link 原点 = 车体底盘中心在地面的投影（z=0 即地面，向上为正）
    轮心 z = -wheel_radius（轮子最低点正好贴地）
    雷达/相机 z = 离地高度
  ────────────────────────────────────────────────────────────────────────────
-->
<robot name="mecanum_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ════════════════ 尺寸参数：把这里改成你量到的数值 ════════════════ -->
  <!-- 轮子 -->
  <xacro:property name="wheel_radius" value="0.03295" />   <!-- 轮半径 (m) -->
  <xacro:property name="wheel_width"  value="0.02" />      <!-- 轮厚 (m) -->
  <xacro:property name="wheelbase"    value="0.12" />      <!-- 轴距：前轮轴中心到后轮轴中心 -->
  <xacro:property name="track_width"  value="0.1674" />    <!-- 轮距：左轮中心到右轮中心 -->
  <!-- 车体（碰撞用，量底盘实际长宽高） -->
  <xacro:property name="base_length"  value="0.18" />      <!-- 车体长 -->
  <xacro:property name="base_width"   value="0.18" />      <!-- 车体宽 -->
  <xacro:property name="base_height"  value="0.05" />      <!-- 车体高 -->
  <!-- 雷达 -->
  <xacro:property name="lidar_x" value="0.0" />            <!-- 前后偏移，前正后负 -->
  <xacro:property name="lidar_y" value="0.0" />            <!-- 左右偏移 -->
  <xacro:property name="lidar_z" value="0.12059" />        <!-- 离地高度 -->
  <!-- 相机 -->
  <xacro:property name="camera_x" value="0.10597" />       <!-- 前后偏移（车头为正） -->
  <xacro:property name="camera_z" value="0.029874" />      <!-- 离地高度 -->
  <!-- IMU -->
  <xacro:property name="imu_x" value="0.0" />              <!-- 前后偏移 -->
  <xacro:property name="imu_y" value="0.0" />              <!-- 左右偏移 -->
  <xacro:property name="imu_z" value="0.0" />              <!-- 离地高度 -->
  <!-- 质量（真机模型无影响，仿真才用，大致填就行） -->
  <xacro:property name="chassis_mass" value="0.47" />
  <xacro:property name="wheel_mass"   value="0.05" />
  <!-- ════════════════════════════════════════════════════════════════════ -->

  <material name="chassis_material">
    <color rgba="0.5 0.7 0.9 1"/>
  </material>
  <material name="wheel_material">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="sensor_material">
    <color rgba="0.8 0.3 0.3 1"/>
  </material>

  <!-- 地面投影坐标系（NAV2 常用），和 base_link 重合 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════ 底盘 ════════════════ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass/12*(base_width**2 + base_height**2)}"
               ixy="0" ixz="0"
               iyy="${chassis_mass/12*(base_length**2 + base_height**2)}"
               iyz="0"
               izz="${chassis_mass/12*(base_length**2 + base_width**2)}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="chassis_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ════════════════ 麦轮宏 ════════════════
       side: 左轮 "+1"（绕 y 正方向转），右轮 "-1"（绕 y 负方向转）
       x:    前后（±wheelbase/2），y: 左右（±track_width/2），z: -wheel_radius
  ═══════════════════════════════════════════════ -->
  <xacro:macro name="mecanum_wheel" params="name side x y z">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass/12*(3*wheel_radius**2 + wheel_width**2)}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass/2*wheel_radius**2}"
                 iyz="0"
                 izz="${wheel_mass/12*(3*wheel_radius**2 + wheel_width**2)}"/>
      </inertial>
      <visual>
        <!-- rpy 绕 x 转 90°，让圆柱轴（默认 z）变成 y，即绕 y 轴滚动 -->
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_material"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}"/>
      <axis xyz="0 ${side} 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel name="left_front_wheel" side="1"
                       x="${ wheelbase/2}" y="${ track_width/2}" z="${-wheel_radius}"/>
  <xacro:mecanum_wheel name="left_back_wheel"  side="1"
                       x="${-wheelbase/2}" y="${ track_width/2}" z="${-wheel_radius}"/>
  <xacro:mecanum_wheel name="right_front_wheel" side="-1"
                       x="${ wheelbase/2}" y="${-track_width/2}" z="${-wheel_radius}"/>
  <xacro:mecanum_wheel name="right_back_wheel"  side="-1"
                       x="${-wheelbase/2}" y="${-track_width/2}" z="${-wheel_radius}"/>

  <!-- ════════════════ 雷达 ════════════════ -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="sensor_material"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- ════════════════ 相机（可俯仰） ════════════════ -->
  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="sensor_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="revolute">
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.4" upper="1" effort="0" velocity="0"/>
  </joint>

  <!-- ════════════════ 相机2（原亚博模型里的第二路相机/传感器） ════════════════ -->
  <link name="camera2_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
      <material name="sensor_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.03 0.03"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera2_joint" type="revolute">
    <origin xyz="${camera_x} 0 ${camera_z + 0.03}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera2_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1" upper="1" effort="0" velocity="0"/>
  </joint>

  <!-- ════════════════ IMU ════════════════ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="sensor_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

</robot>
